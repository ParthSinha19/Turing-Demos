const el=id=>document.getElementById(id);
function setPose(f){
  const[la,ra,ll,rl,y,r,sx]=f;
  el('armL').style.transform=`rotate(${la}deg)`;
  el('armR').style.transform=`rotate(${-ra}deg)`;
  el('legL').style.transform=`rotate(${ll}deg)`;
  el('legR').style.transform=`rotate(${-rl}deg)`;
  el('bot').style.transform=`translateY(${y}px) rotate(${r}deg) scaleX(${sx==null?1:sx})`;
}
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
let token=0;
function setGlow(c){document.documentElement.style.setProperty('--glow',c||'#ff58a8')}
function showBubble(html){$('#bubble').innerHTML=html?`<div>${html}</div>`:''}
async function perform(seq,opt={}){
  const my=++token,beat=opt.beat||680;
  setGlow(null);showBubble('');
  for(let i=0;i<seq.length;i++){
    if(my!==token)return false;
    const mv=MV[seq[i]];
    if(opt.onStep)opt.onStep(i);
    $('#now').textContent=`Move ${i+1} of ${seq.length}: ${mv.name}`;
    setPose(mv.a);await sleep(beat/2);
    if(my!==token)return false;
    setPose(mv.b);await sleep(beat/2);
  }
  if(my!==token)return false;
  setPose(REST);if(opt.onStep)opt.onStep(-1);
  $('#now').textContent='Ready for a dance';
  return true;
}
function hlChip(i){document.querySelectorAll('#tray .chip').forEach((c,k)=>c.classList.toggle('on',k===i))}
function preview(id){perform([id],{beat:900})}

