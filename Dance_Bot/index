}
function explain(L){
  const m=S.model;
  const steps=L.path.length?L.path.map(p=>`<div>Does it ${esc(ML.phrase(p.f,p.thr,nm))}? <b class="${p.yes?'y':'n'}">${p.yes?'Yes':'No'}</b></div>`).join(''):'<div>All my training dances were one style, so I had no questions to ask.</div>';
  const counts=Object.entries(L.counts).map(([id,n])=>`<span class="sty" style="--c:${cinfo(id).color}">${n} ${esc(cinfo(id).name)}</span>`).join('');
  let warn='';
  if(L.tie)warn+='<p class="note">It was a tie in this group, so my pick is close to a coin flip.</p>';
  else if(L.n<3)warn+=`<p class="note">Only ${L.n} training dance${L.n===1?'':'s'} back this guess. That is thin evidence.</p>`;
  if(L.unseen.length)warn+=`<p class="note">I never saw ${L.unseen.map(i=>esc(nm(i))).join(', ')} in training, so I could not learn anything about ${L.unseen.length===1?'it':'them'}.</p>`;
  return`<div class="steps">${steps}</div><p class="note">I landed in a group of ${L.n} training dance${L.n===1?'':'s'}:</p><div class="counts">${counts}</div>${warn}`;
}
function pTest(){
  const L=S.last;
  let free;
  if(!L)free='<p class="note">Build a dance, then press "Ask the robot which style this is". The reasoning appears here.</p>';
  else{
    const c=cinfo(L.cls);
    const reveal=L.intended==null
      ?`<p class="note">What did you mean it to be?</p><div class="counts">${S.styles.map(s=>`<button class="sty" style="--c:${s.color}" data-act="reveal" data-id="${s.id}">${esc(s.name)}</button>`).join('')}</div>`
      :`<div class="verdict">${L.intended===L.cls?'<span class="ok-t">The robot got it.</span>':`<span class="no-t">A mistake. You meant</span> ${chipOf(L.intended)}`}</div>${L.intended!==L.cls?`<div class="row"><button class="btn sm" data-act="lastToTrain">Add as a training example</button><button class="btn sm" data-act="lastToExam">Save to the exam</button></div><p class="note">Adding an example does not teach the robot until you press Teach the robot again.</p>`:''}`;
    free=`<div class="verdict"><span class="ic" style="font-size:22px">${icons(L.seq)}</span></div>
    <div class="verdict"><b>My guess:</b> ${chipOf(L.cls)}</div>
    <p class="note">Made by Brain ${L.mv}${L.stale?', which was already out of date when I guessed':''}.</p>${explain(L)}${reveal}`;
  }
  const log=S.log.length?`<p class="note">Recent guesses</p><div class="res">${S.log.slice(0,6).map(l=>`<div class="r"><span class="ic">${icons(l.seq)}</span>${chipOf(l.cls)}${l.intended!=null?(l.intended===l.cls?'<span class="ok-t">right</span>':'<span class="no-t">wrong</span>'):'<span class="note">not revealed</span>'}</div>`).join('')}</div>`:'';
  /* exam */
  const cf=n=>S.examples.some(e=>key(e.seq)===key(n.seq));
  const items=S.exam.map(x=>`<div class="r"><span class="ic">${icons(x.seq)}</span>${sty(x.styleId)?chipOf(x.styleId):'<span class="note">style deleted, not scored</span>'}<button class="btn sm" data-act="examPlay" data-id="${x.id}">Play</button><button class="btn sm" data-act="examToTrain" data-id="${x.id}">Use for training</button><button class="btn sm" data-act="examDel" data-id="${x.id}">Remove</button>${cf(x)?'<span class="flag">Also in the training examples, so this is not a fair test.</span>':''}</div>`).join('');
  let results='';
  const le=S.lastExam;
  if(le){
    const cur=le.exam===S.examVersion;
    results=`<h3 style="font-size:18px">Latest result: Brain ${le.mv}, ${le.correct} of ${le.total} correct</h3>${cur?'':'<p class="warnbox">The exam has changed since this result.</p>'}<div class="res">${le.rows.map(r=>`<div class="r"><span class="ic">${icons(r.seq)}</span><span class="note">meant</span>${chipOf(r.want)}<span class="note">guessed</span>${chipOf(r.got)}${r.ok?'<span class="ok-t">right</span>':'<span class="no-t">wrong</span>'}</div>`).join('')}</div>`;
  }
  const groups={};
  S.history.forEach(h=>Object.keys(h.scores).forEach(ev=>{(groups[ev]=groups[ev]||[]).push({h,sc:h.scores[ev]})}));
  const gk=Object.keys(groups).map(Number).sort((a,b)=>b-a);
  const hist=gk.length?gk.map(ev=>{
    const rows=groups[ev].sort((a,b)=>a.h.v-b.h.v);
    return`<div class="card" style="background:var(--panel-2)"><b>Exam ${ev}</b> <span class="note">${ev===S.examVersion?'current exam. Scores below use the same questions, so they can be compared.':'an older exam. Do not compare these with the current one.'}</span>${rows.map((r,i)=>{const f=r.sc.correct/r.sc.total,d=i?r.sc.correct-rows[i-1].sc.correct:null;return`<div class="hrow"><b>Brain ${r.h.v}</b><span class="note">${r.h.nTrain} dances</span><div class="bar" style="--c:var(--good)"><u style="width:${f*100}%"></u></div><span>${r.sc.correct}/${r.sc.total}</span>${d==null?'':`<span class="${d>0?'ok-t':d<0?'no-t':'note'}">${d>0?'+':''}${d} vs Brain ${rows[i-1].h.v}</span>`}</div>`}).join('')}</div>`;
  }).join(''):'';
  const add=S.styles.length?`<span class="note">Add your current dance to the exam as:</span><div class="counts">${S.styles.map(s=>`<button class="sty" style="--c:${s.color}" data-act="examAdd" data-id="${s.id}">${esc(s.name)}</button>`).join('')}</div>`:'';
  return`<div class="card sec"><h3>Free play</h3><p class="hint">Invent any dance and see what the robot makes of it. You choose when to reveal what you meant.</p>${free}${log}</div>
  <div class="card sec"><h3>Fair exam</h3><p class="hint">To tell whether a change really helped, score every brain on the same set of dances that were never used for training. These dances stay out of training unless you move them in yourself.</p>
  ${items||'<p class="note">The exam is empty.</p>'}${add}
  <div class="row"><button class="btn primary" data-act="runExam">Run the exam on the current brain</button></div>${results}${hist}</div>`;
}
function tr(node,d,on,path){
  if(node.leaf){
    const c=cinfo(node.cls);
    const ct=Object.entries(node.counts).map(([id,n])=>`${n} ${cinfo(id).name}`).join(', ');
    return`<div class="leaf ${on?'hl':''}" style="--c:${c.color}"><b>${esc(c.name)}</b><span>${esc(ct)}</span></div>`;
  }
  const st=on&&path?path[d]:null;
  return`<div class="node ${on?'hl':''}"><div class="q">Does it ${esc(ML.phrase(node.f,node.thr,nm))}?</div><div class="br"><div class="yes ${st&&st.yes?'go':''}"><em>Yes</em>${tr(node.yes,d+1,!!(st&&st.yes),path)}</div><div class="no ${st&&!st.yes?'go':''}"><em>No</em>${tr(node.no,d+1,!!(st&&!st.yes),path)}</div></div></div>`;
}
function pLab(){
  const m=S.model;
  let brain='<p class="note">Teach the robot first and its learned questions appear here.</p>';
  if(m){
    const path=S.last&&S.last.mv===m.v?S.last.path:null;
    brain=`<p class="hint">These are the questions the robot learned to ask. Each end box shows how many training dances landed there.${path?' The pink route is your latest guess.':''}</p><div class="tree">${tr(m.tree,0,!!path,path)}</div>${status()==='stale'?'<p class="warnbox">This is Brain '+m.v+'. Your examples have changed since, so teach the robot again to see a new map.</p>':''}`;
  }
  const feats=S.tray.length?`<div class="feat">${ML.features(S.tray,nm).map(f=>`<span>${esc(f)}</span>`).join('')}</div><p class="note">This list is all the robot sees of your dance. It keeps counts, neighbouring pairs, the first move and the last move. It cannot see how far apart two moves are, so some patterns are invisible to it.</p>`:'<p class="note">Build a dance to see how the robot describes it.</p>';
  let ord='';
  if(S.order){
    const o=S.order;
    ord=`<div class="res"><div class="r"><span class="ic">${icons(o.a)}</span>${chipOf(o.ca)}</div><div class="r"><span class="ic">${icons(o.b)}</span>${chipOf(o.cb)}</div></div><p class="note">${o.ca===o.cb?'Same answer for both orders. For this dance the order did not matter to the robot.':'Different answers. Order matters here, because the robot looks at which moves come straight after which.'}</p>`;
  }
  const cnt=S.styles.map(s=>({s,n:S.examples.filter(e=>e.styleId===s.id).length}));
  const mx=Math.max(1,...cnt.map(c=>c.n)),nz=cnt.filter(c=>c.n>0).map(c=>c.n);
  const unbal=nz.length>1&&Math.max(...nz)/Math.min(...nz)>=2;
  const bal=`${cnt.map(c=>`<div class="hrow"><b style="min-width:130px;font-weight:500">${esc(c.s.name)}</b><div class="bar" style="--c:${c.s.color}"><u style="width:${c.n/mx*100}%"></u></div><span>${c.n}</span></div>`).join('')}<p class="note">${unbal?'Some styles have at least twice as many examples as others. The robot may lean towards the biggest style.':'The styles have a similar number of examples.'}</p>`;
  let over='<p class="note">Teach the robot, then run the exam on the Test tab to compare.</p>';
  if(m){
    const h=S.history.find(h=>h.v===m.v),sc=h&&h.scores[S.examVersion];
    over=`<div class="hrow"><b style="min-width:150px;font-weight:500">Dances it studied</b><div class="bar" style="--c:var(--good)"><u style="width:${m.trainAcc*100}%"></u></div><span>${pct(m.trainAcc)}</span></div>`+(sc?`<div class="hrow"><b style="min-width:150px;font-weight:500">Unseen exam dances</b><div class="bar" style="--c:var(--warn)"><u style="width:${sc.correct/sc.total*100}%"></u></div><span>${pct(sc.correct/sc.total)}</span></div><p class="note">${m.trainAcc-sc.correct/sc.total>=.25?'Big gap. The robot may have memorised its examples more than it learned a pattern.':'The two scores are close, so the robot is handling new dances about as well as old ones.'}</p>`:'<p class="note">Run the exam on this brain to see how it does on dances it never studied.</p>');
  }
  return`<div class="card sec"><h3>The robot's brain</h3>${brain}</div>
  <div class="card sec"><h3>How the robot sees your dance</h3>${feats}</div>
  <div class="card sec"><h3>Does order matter?</h3><p class="hint">Ask about your dance, then the same moves backwards.</p><div class="row" style="margin:0"><button class="btn" data-act="orderTest">Compare with reversed</button></div>${ord}</div>
  <div class="card sec"><h3>Is the data balanced?</h3>${bal}</div>
  <div class="card sec"><h3>Studied or understood?</h3>${over}</div>
  <div class="card sec"><h3>Experiments to try</h3><div class="exps">${EXPERIMENTS.map(e=>`<div class="exp"><b>${e[0]}</b><small>${e[1]}</small><p>${e[2]}</p></div>`).join('')}</div></div>
  <div class="card sec"><h3>Discoveries</h3><div class="badges">${Object.entries(BADGES).map(([k,v])=>`<div class="badge ${S.badges[k]?'got':''}"><b>${v[0]}</b>${v[1]}</div>`).join('')}</div></div>`;
}
function renderPanel(){
  const p=$('#panel'),f=U.tab==='moves'?pMoves:U.tab==='styles'?pStyles:U.tab==='test'?pTest:pLab;
  p.innerHTML=f();
  if(U.tab==='styles'&&U.rename){const i=el('renameIn');if(i){i.focus();i.select()}}
}
function render(){renderHead();renderTray();renderTabs();renderPanel();save()}

/* ---------- Actions ---------- */
function train(){
  const order=S.styles.filter(s=>S.examples.some(e=>e.styleId===s.id)).map(s=>s.id);
  if(order.length<2){toast('Give at least two styles one dance each, then teach the robot.');return}
  const rows=S.examples.filter(e=>order.includes(e.styleId)).map(e=>({seq:e.seq,cls:e.styleId}));
  const tree=ML.build(rows,order);
  const acc=ML.evaluate(tree,rows);
  const v=S.nmodel++;
  S.model={v,tree,classes:order.map(id=>({id,name:sty(id).name,color:sty(id).color})),dsVersion:S.dsVersion,nTrain:rows.length,trainAcc:acc,vocab:[...new Set(rows.flatMap(r=>r.seq))]};
  S.history.push({v,dsVersion:S.dsVersion,nTrain:rows.length,trainAcc:acc,scores:{}});
  badge('first');
  const svg=el('robot');svg.classList.add('thinking');token++;setPose(REST);setGlow(null);
  showBubble('Thinking…');$('#now').textContent='Learning from '+rows.length+' dances';
  render();
  setTimeout(()=>{svg.classList.remove('thinking');showBubble(`I learned ${order.length} styles from ${rows.length} dances.`);$('#now').textContent='Ready for a dance'},900);
}
function ask(){
  if(!S.model){toast('The robot has not learned anything yet. Press Teach the robot first.');return}
  if(!S.tray.length){toast('Build a dance first.');return}
  const seq=[...S.tray],p=ML.predict(S.model.tree,seq),stale=status()==='stale';
  if(stale)badge('stale');
  const vocab=new Set(S.model.vocab),unseen=[...new Set(seq.filter(x=>!vocab.has(x)))];
  const id=S.nid++;
  S.last={id,seq,cls:p.cls,path:p.path,counts:p.leaf.counts,n:p.leaf.n,tie:p.leaf.tie,mv:S.model.v,stale,unseen,intended:null};
  S.log.unshift({id,seq,cls:p.cls,intended:null});S.log=S.log.slice(0,8);
  render();
  const c=cinfo(p.cls);
  perform(seq,{onStep:hlChip}).then(ok=>{
    if(!ok)return;
    setGlow(c.color);
    showBubble(`<span class="dot" style="--c:${c.color}"></span>I guess <b>${esc(c.name)}</b><button data-act="tab" data-id="test">Why?</button>`);
  });
}
function addEx(styleId){
  if(S.tray.length<2){toast('A dance needs at least two moves.');return}
  S.examples.push({id:uid('e'),seq:[...S.tray],styleId});
  dataChanged();
  toast(`Added to ${sty(styleId).name}. The robot only learns it after you teach it again.`);
  render();
}
function scoreExam(){
  if(!S.model){toast('Teach the robot first.');return}
  const items=S.exam.filter(x=>sty(x.styleId));
  if(!items.length){toast('Add dances to the exam first.');return}
  const rows=items.map(x=>{const g=ML.predict(S.model.tree,x.seq).cls;return{seq:x.seq,want:x.styleId,got:g,ok:g===x.styleId}});
  const correct=rows.filter(r=>r.ok).length;
  S.lastExam={mv:S.model.v,exam:S.examVersion,correct,total:rows.length,rows};
  const h=S.history.find(h=>h.v===S.model.v);
  if(h)h.scores[S.examVersion]={correct,total:rows.length};
  const vs=new Set(S.history.filter(h=>h.scores[S.examVersion]).map(h=>h.v));
  if(vs.size>=2)badge('fair');
  if(status()==='stale')toast('This scored the old brain. The examples have changed since it learned.');
  render();
}
const A={
  tab:(id)=>{U.tab=id;render()},
  cat:(id)=>{U.cat=id;render()},
  pick:(id)=>{
    if(U.sel!=null&&U.replace&&S.tray[U.sel]){S.tray[U.sel]=id;U.replace=false}
    else if(S.tray.length>=MAXLEN){toast('Dances can have up to '+MAXLEN+' moves.');return}
    else if(U.sel!=null&&S.tray[U.sel]){S.tray.splice(U.sel+1,0,id);U.sel++}
    else S.tray.push(id);
    preview(id);render();
  },
  look:(id)=>preview(id),
  sel:(_,i)=>{U.sel=U.sel===i?null:i;U.replace=false;render()},
  left:()=>{const i=U.sel;if(i>0){[S.tray[i-1],S.tray[i]]=[S.tray[i],S.tray[i-1]];U.sel=i-1}render()},
  right:()=>{const i=U.sel;if(i<S.tray.length-1){[S.tray[i+1],S.tray[i]]=[S.tray[i],S.tray[i+1]];U.sel=i+1}render()},
  repeat:()=>{if(S.tray.length>=MAXLEN){toast('Dances can have up to '+MAXLEN+' moves.');return}S.tray.splice(U.sel+1,0,S.tray[U.sel]);U.sel++;render()},
  replace:()=>{U.replace=!U.replace;render()},
  remove:()=>{S.tray.splice(U.sel,1);U.sel=null;U.replace=false;render()},
  done:()=>{U.sel=null;U.replace=false;render()},
  clear:()=>{S.tray=[];U.sel=null;U.replace=false;token++;setPose(REST);render()},
  play:()=>{if(!S.tray.length){toast('Add some moves first.');return}perform(S.tray,{onStep:hlChip})},
  saveEx:(id)=>addEx(id),
  ask,train,
  newStyle:()=>{
    const inp=el('newStyle'),n=inp.value.trim();
    if(!n){toast('Type a name for your style first.');return}
    if(S.styles.length>=MAXSTYLES){toast('That is the most styles for now: '+MAXSTYLES+'.');return}
    if(S.styles.some(s=>s.name.toLowerCase()===n.toLowerCase())){toast('You already have a style with that name.');return}
    const used=new Set(S.styles.map(s=>s.color)),color=PALETTE.find(c=>!used.has(c))||PALETTE[0];
    S.styles.push({id:uid('s'),name:n,color});render();
  },
  renameStart:(id)=>{U.rename=id;render()},
  renameCancel:()=>{U.rename=null;render()},
  renameSave:(id)=>{
    const n=el('renameIn').value.trim();
    if(!n){toast('A style needs a name.');return}
    if(S.styles.some(s=>s.id!==id&&s.name.toLowerCase()===n.toLowerCase())){toast('You already have a style with that name.');return}
    sty(id).name=n;U.rename=null;render();
  },
  delAsk:(id)=>{U.delStyle=id;render()},
  delNo:()=>{U.delStyle=null;render()},
  delYes:(id)=>{
    S.examples=S.examples.filter(e=>e.styleId!==id);
    S.styles=S.styles.filter(s=>s.id!==id);
    if(S.exam.some(x=>x.styleId===id))S.examVersion++;
    U.delStyle=null;dataChanged();render();
  },
  exPlay:(id)=>{const e=S.examples.find(e=>e.id===id);if(e)perform(e.seq)},
  exDel:(id)=>{S.examples=S.examples.filter(e=>e.id!==id);dataChanged();render()},
  reveal:(id)=>{
    const L=S.last;if(!L)return;
    L.intended=id;const l=S.log.find(l=>l.id===L.id);if(l)l.intended=id;
    if(id!==L.cls){badge('mistake');toast('A mistake. That tells you something about the examples.')}else toast('The robot got it.');
    render();
  },
  lastToTrain:()=>{const L=S.last;if(L.seq.length<2){toast('A dance needs at least two moves.');return}S.examples.push({id:uid('e'),seq:[...L.seq],styleId:L.intended});dataChanged();toast('Added as a training example. Teach the robot again to learn from it.');render()},
  lastToExam:()=>{const L=S.last;S.exam.push({id:uid('x'),seq:[...L.seq],styleId:L.intended});S.examVersion++;toast('Saved to the exam. This starts a new exam, so older scores are not comparable.');render()},
  examAdd:(id)=>{
    if(!S.tray.length){toast('Build a dance first.');return}
    S.exam.push({id:uid('x'),seq:[...S.tray],styleId:id});S.examVersion++;
    if(S.examples.some(e=>key(e.seq)===key(S.tray)))toast('Added, but this exact dance is also a training example.');
    else toast('Added to the exam. This starts a new exam, so older scores are not comparable.');
    render();
  },
  examDel:(id)=>{S.exam=S.exam.filter(x=>x.id!==id);S.examVersion++;render()},
  examPlay:(id)=>{const x=S.exam.find(x=>x.id===id);if(x)perform(x.seq)},
  examToTrain:(id)=>{
    const x=S.exam.find(x=>x.id===id);if(!x)return;
    if(!sty(x.styleId)){toast('Its style was deleted. Remove it or pick a style first.');return}
    S.exam=S.exam.filter(y=>y.id!==id);S.examVersion++;
    S.examples.push({id:uid('e'),seq:x.seq,styleId:x.styleId});dataChanged();
    toast('Moved into training. The exam lost a dance, so it is a new exam.');render();
  },
  runExam:scoreExam,
  orderTest:()=>{
    if(!S.model){toast('Teach the robot first.');return}
    if(S.tray.length<2){toast('Build a dance with at least two moves.');return}
    const a=[...S.tray],b=[...a].reverse();
    const ca=ML.predict(S.model.tree,a).cls,cb=ML.predict(S.model.tree,b).cls;
    S.order={a,b,ca,cb};
    if(ca!==cb)badge('order');
    render();
  },
  sample:()=>{const n=seed();S={...n,badges:S.badges,nmodel:S.nmodel,history:S.history,model:null,dsVersion:S.dsVersion+1,examVersion:S.examVersion+1};U.sel=null;toast('Sample dances reloaded. Teach the robot to learn from them.');render()},
  resetAsk:()=>{U.confirmReset=true;render()},
  resetNo:()=>{U.confirmReset=false;render()},
  resetYes:()=>{S={styles:[],examples:[],exam:[],dsVersion:S.dsVersion+1,examVersion:S.examVersion+1,model:null,history:S.history,badges:S.badges,last:null,log:[],order:null,lastExam:null,tray:[],nid:S.nid,nmodel:S.nmodel};U.confirmReset=false;U.sel=null;U.tab='styles';token++;setPose(REST);showBubble('');render()}
};
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;
  const f=A[b.dataset.act];if(f)f(b.dataset.id,b.dataset.i!=null?+b.dataset.i:null,b);
});
document.addEventListener('change',e=>{
  const s=e.target.closest('[data-chg]');if(!s||s.dataset.chg!=='reassign')return;
  const ex=S.examples.find(x=>x.id===s.dataset.id);if(!ex)return;
  ex.styleId=s.value;dataChanged();render();
});
document.addEventListener('keydown',e=>{
  if(e.key==='Enter'&&e.target.id==='newStyle'){e.preventDefault();A.newStyle()}
  else if(e.key==='Enter'&&e.target.id==='renameIn'){e.preventDefault();A.renameSave(U.rename)}
  else if(e.key==='Escape'&&e.target.id==='renameIn'){A.renameCancel()}
});

setPose(REST);
render();
})();
</script>

</body></html>
