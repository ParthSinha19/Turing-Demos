function pStyles(){
  const cf=conflicts();
  const cards=S.styles.map(s=>{
    const ex=S.examples.filter(e=>e.styleId===s.id);
    const head=U.rename===s.id
      ?`<div class="newstyle" style="flex:1 1 220px"><input id="renameIn" value="${esc(s.name)}" maxlength="24" aria-label="New name for ${esc(s.name)}"><button class="btn sm" data-act="renameSave" data-id="${s.id}">Save</button><button class="btn sm" data-act="renameCancel">Cancel</button></div>`
