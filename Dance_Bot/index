.stage .floor{position:absolute;left:-25%;right:-25%;bottom:-12%;height:58%;background:conic-gradient(#2c2562 25%,#1b1648 0 50%,#2c2562 0 75%,#1b1648 0) 0 0/70px 70px;transform:perspective(380px) rotateX(62deg);transform-origin:bottom;-webkit-mask-image:linear-gradient(to top,#000 45%,transparent);mask-image:linear-gradient(to top,#000 45%,transparent)}
