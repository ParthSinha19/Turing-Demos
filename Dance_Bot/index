<style>
/* Layout concept: a night-club dance floor. Left: sticky stage (robot on a tiled floor) plus the dance tray.
   Right: a tabbed workbench for moves, styles, testing and the investigation lab. Committed to one dark look. */
:root{
  --bg:#100d22; --panel:#1a1636; --panel-2:#241e48; --line:#3a3270;
  --ink:#f4f0ff; --muted:#aaa2d8; --accent:#ff58a8; --accent-ink:#1c0a15;
  --good:#6df29a; --warn:#ffd23f; --bad:#ff6a6a;
  --f-display:'Bagel Fat One','Arial Rounded MT Bold','Trebuchet MS',system-ui,sans-serif;
  --f-body:'Lexend',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-mono:'DM Mono',ui-monospace,'SFMono-Regular',Menlo,monospace;
  --glow:#ff58a8;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:400 15px/1.5 var(--f-body);padding-inline:16px;padding-block:14px 56px}
button,select,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--warn);outline-offset:2px}
h1,h2,h3{font-family:var(--f-display);font-weight:400;margin:0;line-height:1.1;text-wrap:balance}
p{margin:0}
.wrap{max-width:1240px;margin-inline:auto}
header.top{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;justify-content:space-between}
h1{font-size:clamp(26px,4.4vw,40px);letter-spacing:.01em}
h1 span{color:var(--accent)}
.brainbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;min-width:0}
.brain{display:flex;align-items:center;gap:8px;background:var(--panel);border:2px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13px;min-width:0}
.brain i{width:10px;height:10px;border-radius:50%;background:var(--muted);flex:none}
.brain.ok i{background:var(--good)} .brain.stale{border-color:var(--warn)} .brain.stale i{background:var(--warn)}
.btn{background:var(--panel-2);border:2px solid var(--line);border-bottom-width:5px;border-radius:14px;padding:8px 14px;font-weight:500;font-size:14px;transition:transform .08s}
.btn:active{transform:translateY(2px);border-bottom-width:3px}
.btn.primary{background:var(--accent);border-color:#ff9bcb;border-bottom-color:#b3256f;color:var(--accent-ink);font-weight:600}
.btn.big{width:100%;padding:12px;font-size:16px}
.btn.sm{padding:4px 10px;font-size:12px;border-bottom-width:3px;border-radius:10px}
