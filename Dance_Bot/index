function conflicts(){
  const by={},out={};
  S.examples.forEach(e=>{(by[key(e.seq)]=by[key(e.seq)]||[]).push(e)});
  Object.values(by).forEach(g=>{
    const ids=new Set(g.map(e=>e.styleId));
    if(ids.size>1)g.forEach(e=>{out[e.id]=[...ids].filter(i=>i!==e.styleId)});
  });
  return out;
}
