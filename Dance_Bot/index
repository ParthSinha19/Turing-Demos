(()=>{
/* ---------- Move vocabulary: stable id, name, icon, two pose frames [leftArm,rightArm,leftLeg,rightLeg,lift,tilt,flip] ---------- */
const RAW=[
['clap','Clap','👏','arms',[75,75,6,6,0,0],[25,25,6,6,0,0]],
