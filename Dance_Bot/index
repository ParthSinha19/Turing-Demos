  else if(st==='current')t.textContent=`Brain ${S.model.v} is up to date. It learned ${S.model.classes.length} styles from ${S.model.nTrain} dances.`;
  else t.textContent=`Brain ${S.model.v} is out of date. The examples changed after it learned.`;
